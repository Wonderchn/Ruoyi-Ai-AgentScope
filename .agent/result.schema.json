{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex task result",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "tests", "risks"],
  "properties": {
    "summary": { "type": "string" },
    "tests": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } }
  }
}
