# Build context whitelist for the web image build (infra/docker/ruoyi-web.Dockerfile
# is invoked with the repository root as its context). Everything not listed here is
# excluded, so the build ships only the frontend workspace and the delivery nginx conf.
*
!services/web
!infra/dev
# keep the frontend tree itself lean
services/web/**/node_modules
services/web/**/dist
services/web/**/.git
services/web/**/.env
services/web/**/.env.*
!services/web/**/.env.example
infra/dev/.env
infra/dev/.env.*
!infra/dev/.env.example
